#: .\templates\users\preferences.html:7
msgid "Preferences - Yamtrack"
msgstr "偏好设置 - Yamtrack"

#: .\templates\users\preferences.html:16
msgid "Customize the look and behavior of the application."
msgstr "调整应用的外观与行为。"

#: .\templates\users\preferences.html:26
msgid "Hide Hover Overlay on Touch Devices"
msgstr "在触屏设备上隐藏悬浮操作层"

#: .\templates\users\preferences.html:29
msgid "Hide the media card hover overlay with action buttons on touch devices for a cleaner mobile experience. On desktop, the overlay will still appear when you hover your mouse over media cards."
msgstr "在触屏设备上隐藏媒体卡片上带操作按钮的悬浮层，手机端更清爽。桌面端鼠标悬停时仍会显示。"

#: .\templates\users\preferences.html:49
msgid "Obfuscate Unseen Episodes"
msgstr "模糊处理未看剧集"

#: .\templates\users\preferences.html:51
msgid "When enabled, unseen episode images and descriptions will be blurred."
msgstr "开启后，未看剧集的图片和简介会被模糊处理。"

#: .\templates\users\preferences.html:70
msgid "Bulk Completion Date"
msgstr "批量完成日期"

#: .\templates\users\preferences.html:73
msgid "When marking a TV show or season as completed, its episodes will be marked as completed with this date."
msgstr "把剧集或某季标记为已通关时，其中各集也会以这个日期标记为已通关。"

#: .\templates\users\preferences.html:92
msgid "Show progress bar on media items"
msgstr "在媒体条目上显示进度条"

#: .\templates\users\preferences.html:95
msgid "Display a progress bar on media items. Items which don't have max progress will be using a dotted line."
msgstr "在媒体条目上显示进度条。没有总进度的条目会用虚线表示。"

#: .\templates\users\preferences.html:115
msgid "Hide completed media in recommendations"
msgstr "推荐中隐藏已通关的媒体"

#: .\templates\users\preferences.html:118
msgid "Hide media you've already completed from the recommendations section on detail pages."
msgstr "在详情页的推荐里隐藏你已通关的媒体。"

#: .\templates\users\preferences.html:138
msgid "Hide zero ratings"
msgstr "隐藏 0 分"

#: .\templates\users\preferences.html:140
msgid "Hide the rating badge from media cards when the rating is zero."
msgstr "评分为 0 时隐藏媒体卡片上的评分角标。"

#: .\templates\users\preferences.html:159
msgid "Date Format"
msgstr "日期格式"

#: .\templates\users\preferences.html:161
msgid "Choose how dates are displayed throughout the application."
msgstr "选择整个网站中日期的显示方式。"

#: .\templates\users\preferences.html:179
msgid "Time Format"
msgstr "时间格式"

#: .\templates\users\preferences.html:181
msgid "Choose between 12-hour or 24-hour clock display."
msgstr "选择 12 小时制还是 24 小时制。"

#: .\templates\users\preferences.html:199
msgid "Week Start Day"
msgstr "每周起始日"

#: .\templates\users\preferences.html:201
msgid "Choose which day the week starts on for calendars and statistics."
msgstr "选择日历和统计中每周从哪天开始。"

#: .\templates\users\preferences.html:219
msgid "Watch provider region"
msgstr "播放平台地区"

#: .\templates\users\preferences.html:222
msgid "Choose the region to show watch providers for. Setting this to disabled will hide the box from the media page."
msgstr "选择播放平台的地区。设为关闭后，媒体页面将不再显示该模块。"

#: .\templates\users\preferences.html:241
msgid "Media Types"
msgstr "媒体类型"

#: .\templates\users\preferences.html:244
msgid "Control which media types are visible throughout the app (sidebar, search, calendar, notifications)."
msgstr "控制哪些媒体类型在应用中可见（侧边栏、搜索、日历、通知）。"

#: .\templates\users\preferences.html:274
msgid "Save Preferences"
msgstr "保存偏好设置"
