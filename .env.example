# ============================================================
# Steam 游戏记录站（life joy / yamtrack）· .env 模板
# ------------------------------------------------------------
# 用法：把本文件复制成项目根目录的 .env，再把 <...> 换成你自己的真实值。
#   Windows:  copy .env.example .env
#   然后照下面的注释一条条填。留空的键保留那一行即可（值可以空）。
#
# 文件格式：一行一个 KEY=VALUE，不要加引号，不要留行尾空格。
# 本文件里的值全部是占位符，绝不要把它们当真实值用。
#
# 两条铁律（踩了站点就打不开）：
#   1) DB_HOST 绝对不能设 —— 一设就走 Postgres，本项目是 SQLite，立刻报错。
#      不必留一行空的 DB_HOST，整行都不要写。
#   2) DEBUG 必须保持 True —— 关掉以后 Django 不再代管静态文件，
#      CSS/JS 全 404，页面变纯文字。想藏 debug_toolbar 请用 INTERNAL_IPS=[]，
#      不要动 DEBUG。
# ============================================================


# ------------------------------------------------------------
# 【必需】不填基本跑不起来
# ------------------------------------------------------------

# Django 的签名密钥：填一串随机长字符串（50 位左右字母数字混合），
# 别用这里的示例值，也别外传。缺了会退回代码里写死的默认值，
# 本地自用勉强能跑，但等于把会话签名公开了。
SECRET=<填你的随机长字符串>

# 必须是 True。原因见文件开头的铁律 2。
DEBUG=True

# Redis 地址：Celery 消息队列和 Django 缓存都靠它。
# 本站用项目自带的便携 Redis（.tools/redis/redis-server.exe，由 start-win.vbs 拉起），
# 所以这一行照抄即可，不用改。
REDIS_URL=redis://127.0.0.1:6379/0

# Steam 网页版申请的 Web API Key（32 位十六进制），申请地址：
# https://steamcommunity.com/dev/apikey
# 导入游戏库、拉成就都靠它，没有就导不进任何东西。
STEAM_API_KEY=<你的32位Key>

# 你自己的 Steam 64 位 ID（7656 开头的 17 位数字），
# 在 Steam 个人资料页地址里能看到，或用 steamid.io 查。
STEAM_ID=<7656开头的17位ID>


# ------------------------------------------------------------
# 【可选】不填也能跑，只是对应功能不可用
# ------------------------------------------------------------

# 允许访问站点的域名列表。本地自用填 * 即可。
ALLOWED_HOSTS=*

# 时区。影响「今天/本周」这类统计口径，按自己所在地填，例如：
# Asia/Shanghai、Asia/Hong_Kong、Asia/Tokyo
TZ=Asia/Shanghai

# 本地免登录：填一个已存在的用户名（比如 admin），打开站点就自动以该身份登录。
# 只在「自己电脑自己用」时开，别在对外服务器上开。
YAMTRACK_AUTO_LOGIN_USERNAME=<你的用户名>

# Steam 家庭共享令牌：很长（500+ 字符），从网页版 Steam 的
# pointssummary/ajaxgetasyncconfig 接口里取 data.webapi_token。
# 没有也能正常看自己的库，只是看不到家庭共享的游戏。
# 本站由计划任务每天自动续期，手填一次就行。
STEAM_ACCESS_TOKEN=<可留空>

# 豆瓣导入走的本机代理地址（形如 http://host:port）。
# 默认直连，不需要代理就保持注释状态；要用代理池再取消注释并填地址。
# 配了但连不上时程序会自己退回直连。
# DOUBAN_PROXY=<可留空>

# 微信读书导入用的 Key。不用微信读书就留空。
WEREAD_API_KEY=<可留空>

# Notion 导入用的 token。不用 Notion 就留空。
NOTION_TOKEN=<可留空>


# ------------------------------------------------------------
# 【豆瓣代理池专用】纯可选，一个都不配也不影响站点
# ------------------------------------------------------------
# 这几个是 Clash 订阅链接，URL 里带 token，等于账号凭证 —— 属于隐私，
# 只放你自己机器的环境变量里，不要提交进 Git。
# 都不配时 .tools/douban_proxy_pool.py 会打印一句提示后直接跳过（不报错），
# 豆瓣导入就退回直连。要用代理池再取消下面三行的注释：
# DOUBAN_POOL_SUB_A=<你的订阅链接或留空>
# DOUBAN_POOL_SUB_B=<可留空>
# DOUBAN_POOL_SUB_C=<可留空>


# ------------------------------------------------------------
# 【不要写】以下是反向配置，写了反而会坏
# ------------------------------------------------------------
# DB_HOST / DB_NAME / DB_USER / DB_PASSWORD / DB_PORT
#   → 这些是 Postgres 的键。本项目用 SQLite，写了就切库、直接报错。
# BASE_URL
#   → 有值会改写静态文件路径前缀，本地 http://127.0.0.1:8001 会 404。
#     本地跑请留空或干脆不写这一行。
